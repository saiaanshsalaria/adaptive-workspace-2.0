NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive-ai-workspace
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
DOCUMENT_MAX_SIZE=10485760
AI_API_KEY=
AI_API_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Adaptive Workspace <no-reply@example.com>
